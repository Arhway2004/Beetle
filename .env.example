# Copy to .env (git-ignored) and fill in. Never commit real values.

# ---- PostgreSQL (docker-compose) ----
POSTGRES_USER=beetle
POSTGRES_PASSWORD=change-me
POSTGRES_DB=beetle_keeper
POSTGRES_PORT=5432

# ---- services/api ----
# SQLAlchemy URL used by the API and by database/migrate.py
DATABASE_URL=postgresql+psycopg://beetle:change-me@localhost:5432/beetle_keeper
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list. Leave empty to disable CORS.
API_CORS_ORIGINS=

# ---- services/ai-gateway (runs natively on the Mac, not in Docker) ----
# Generate with: make gateway-token
GATEWAY_TOKEN=
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8443
# Paths to a TLS certificate/key (make gateway-cert). Leave empty only for localhost testing.
GATEWAY_TLS_CERT=
GATEWAY_TLS_KEY=
# Ollama must stay bound to localhost; the gateway is the only network-facing component.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
